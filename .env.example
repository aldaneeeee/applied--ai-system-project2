# Copy this file to `.env` and fill in what you need. Never commit `.env`.
# Every setting is optional: with no .env at all, the app runs offline.

# Your Anthropic API key (https://console.anthropic.com/). When set, the AI DJ
# uses Claude to interpret requests and write explanations.
ANTHROPIC_API_KEY=

# Which backend the AI DJ uses:
#   auto    -> Claude if ANTHROPIC_API_KEY is set, otherwise offline (default)
#   claude  -> always Claude (stops with a clear error if no key is set)
#   offline -> deterministic keyword parser, no network calls
DJ_BACKEND=auto

# Claude model to use.
DJ_MODEL=claude-opus-5-5
