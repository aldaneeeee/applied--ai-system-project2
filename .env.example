# ---------------------------------------------------------------------------
# GroundedRAG environment configuration
# Copy this file to `.env` and fill in the values you want to override.
# Every value has a safe default, so the app runs even with an empty .env.
# ---------------------------------------------------------------------------

# Your Anthropic API key. If this is set (and the `anthropic` package is
# installed), the app uses Claude for planning/answering/verification.
# If it is empty or missing, the app automatically falls back to a fully
# offline, deterministic backend so it still runs and all tests pass.
ANTHROPIC_API_KEY=

# Which Claude model to use. Defaults to the latest Opus.
RAGQA_MODEL=claude-opus-4-8

# Backend selection: auto | anthropic | offline
#   auto      -> use Claude if a key is present, otherwise offline (recommended)
#   anthropic -> force Claude (errors clearly if no key is set)
#   offline   -> force the deterministic offline backend (no network calls)
RAGQA_BACKEND=auto

# Retrieval / pipeline tuning (all optional).
RAGQA_TOP_K=4                 # chunks retrieved per query
RAGQA_MIN_SCORE=0.12          # abstain below this retrieval similarity
RAGQA_MAX_RETRIES=1           # agentic re-retrieval attempts if answer is ungrounded
RAGQA_CHUNK_SIZE=900          # characters per chunk
RAGQA_CHUNK_OVERLAP=150       # character overlap between chunks

# Logging level: DEBUG | INFO | WARNING | ERROR
RAGQA_LOG_LEVEL=INFO
